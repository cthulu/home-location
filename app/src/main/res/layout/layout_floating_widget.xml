<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background">

    <!-- Confirmation message shown briefly after successful add -->
    <TextView
        android:id="@+id/tvConfirmation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:text="✓ Added!"
        android:textColor="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Input row: text input + list icon + send button -->
    <LinearLayout
        android:id="@+id/layoutInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical">

        <!-- Item text input (takes all remaining space) -->
        <EditText
            android:id="@+id/etItemText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Item"
            android:textColorHint="@color/widget_hint"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:maxLines="1" />

        <!-- List picker button (shows list icon, opens dropdown) -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/btnListPicker"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_list"
                android:contentDescription="Select list"
                android:padding="8dp" />

            <!-- Hidden spinner anchored to the FrameLayout -->
            <Spinner
                android:id="@+id/spinnerLists"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:visibility="invisible" />

        </FrameLayout>

        <!-- Send button -->
        <ImageButton
            android:id="@+id/btnAdd"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/btn_send_background"
            android:src="@drawable/ic_send"
            android:contentDescription="Add item"
            android:padding="8dp" />

    </LinearLayout>

</LinearLayout>
